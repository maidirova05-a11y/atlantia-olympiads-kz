# Секреты Docker-версии (см. docs/BACKEND.md).
#   cp docker.env.example docker.env
# docker.env в git не попадает. Значения — те же, что в Vercel → Settings → Environment Variables.
# Адрес базы задавать НЕ нужно: он прописан в compose.yaml.
# https://<портал>.bitrix24.kz/rest/<пользователь>/<код>/
BITRIX_WEBHOOK_URL=
# Необязательно:
# BITRIX_DEAL_CATEGORY_ID=
# BITRIX_DEAL_STAGE_ID=
# BITRIX_STATUS_ID=
# BITRIX_SOURCE_ID=
# BITRIX_ASSIGNED_BY_ID=

# Кабинет результатов и сертификаты (/results): обязательно
# Случайная строка от 32 символов: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RESULTS_SESSION_SECRET=
# Письма с паролями отправляет Resend: домен atlantia-olympiads.kz должен быть подтверждён в Resend (SPF/DKIM)
RESEND_API_KEY=
MAIL_FROM=Atlantia Olympiads <results@atlantia-olympiads.kz>
