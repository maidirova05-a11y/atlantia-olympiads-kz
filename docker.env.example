# Секреты Docker-версии (см. docs/BACKEND.md).
#   cp docker.env.example docker.env
# docker.env в git не попадает. Значения — те же, что в Vercel → Settings → Environment Variables.
# Адрес базы задавать НЕ нужно: он прописан в compose.yaml.
# https://<портал>.bitrix24.kz/rest/<пользователь>/<код>/
BITRIX_WEBHOOK_URL=
